{
  "name": "@hortilink/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Bruna Cristiny Franco",
  "description": "API do HortiLink em TypeScript (Fastify + Supabase), em Clean Architecture.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gerar:seed": "tsx scripts/gerar-seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@hortilink/banco": "workspace:*",
    "@hortilink/dominio": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
