# Copie para .env (que NÃO vai para o git) e preencha.

# --- Servidor
PORT=3333
# 127.0.0.1 = só este computador (o modo demo exige). Em servidor de produção use 0.0.0.0.
HOST=127.0.0.1
# Endereço(s) do site liberado(s) no CORS. Várias versões publicadas? Separe por vírgula:
# FRONTEND_ORIGIN=https://hortilink-site.onrender.com,https://hortilink-sprint2.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings > API)
# Sem estas duas a API roda em MODO DEMO (dados em memória, login "Bearer demo:<id>").
# Em produção (NODE_ENV=production) a API se recusa a subir sem elas.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# A service_role ignora o RLS: só aqui no back-end, nunca no front, no git ou em chat.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Código de retirada (US10)
# Segredo que gera o código de 6 dígitos do comprador. Opcional: sem ele a API usa a
# SUPABASE_SERVICE_ROLE_KEY. Se mudar, os códigos já mostrados deixam de valer.
# CODIGO_RETIRADA_SEGREDO=
